rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function p(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && p().active==true;}
  function master(){return active() && p().role=="master";}
  function actual(){return active() && p().role=="actual";}
  function tally(){return active() && p().role=="tally";}
  function notInitialized(){return !exists(/databases/$(database)/documents/system/bootstrap);}
  function bootstrapAfter(){return getAfter(/databases/$(database)/documents/system/bootstrap).data;}
  function linkedCountEntry(){return getAfter(/databases/$(database)/documents/countEntries/$(request.resource.data.countEntryId)).data;}

  match /system/bootstrap {
    allow read: if true;
    allow create: if signed() && notInitialized()
      && request.resource.data.initialized == true
      && request.resource.data.masterUid == request.auth.uid
      && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master";
    allow update, delete: if false;
  }

  match /users/{uid}{
    allow read:if master()||(signed()&&request.auth.uid==uid);
    allow create:if master() || (
      signed() && request.auth.uid==uid && notInitialized()
      && request.resource.data.role=="master"
      && request.resource.data.active==true
      && bootstrapAfter().masterUid==request.auth.uid
    );
    allow update,delete:if master();
  }
  match /items/{id}{
    allow read:if active();
    allow create:if master() || (tally()
      && request.resource.data.keys().hasOnly(["name","aliases","unit","packUnit","packSize","sensitive","active","pendingReview","createdAt","createdBy","source","importId"])
      && request.resource.data.keys().hasAll(["name","aliases","unit","packUnit","packSize","sensitive","active","pendingReview","createdAt","createdBy","source","importId"])
      && request.resource.data.name is string
      && request.resource.data.aliases is list
      && request.resource.data.unit is string
      && request.resource.data.packUnit is string
      && request.resource.data.packSize is number && request.resource.data.packSize>=0
      && request.resource.data.sensitive==false
      && request.resource.data.active==true
      && request.resource.data.pendingReview==true
      && request.resource.data.createdAt==request.time
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.source=="tally_import_auto"
      && request.resource.data.importId is string
      && exists(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId))
      && get(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId)).data.createdBy==request.auth.uid
      && get(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId)).data.status=="processing");
    allow update,delete:if master();
  }
  match /stockLatest/{id}{
    allow read:if master()||tally();
    allow create,update:if (master()||tally())
      && request.resource.data.qty is number && request.resource.data.qty>=0
      && request.resource.data.updatedBy==request.auth.uid
      && existsAfter(/databases/$(database)/documents/items/$(id))
      && ((request.resource.data.importId is string
            && exists(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId))
            && get(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId)).data.createdBy==request.auth.uid
            && get(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId)).data.status=="processing")
          || (master()
            && request.resource.data.restoredFromImportId is string
            && exists(/databases/$(database)/documents/tallyImports/$(request.resource.data.restoredFromImportId))));
    allow delete:if master();
  }
  match /actualLatest/{id}{
    allow read:if master()||actual();
    allow create,update:if (master()||actual())
      && request.resource.data.qty is number && request.resource.data.qty>=0
      && request.resource.data.updatedBy==request.auth.uid
      && request.resource.data.updatedAt==request.time
      && exists(/databases/$(database)/documents/items/$(id))
      && request.resource.data.sessionId is string
      && get(/databases/$(database)/documents/countSessions/$(request.resource.data.sessionId)).data.status=="open"
      && request.resource.data.countEntryId is string
      && existsAfter(/databases/$(database)/documents/countEntries/$(request.resource.data.countEntryId))
      && linkedCountEntry().itemId==id
      && linkedCountEntry().sessionId==request.resource.data.sessionId
      && linkedCountEntry().createdBy==request.auth.uid
      && linkedCountEntry().qty==request.resource.data.qty;
    allow delete:if master();
  }
  match /countSessions/{id}{
    allow read:if master()||actual();
    allow create:if master() || (actual()
      && id.matches('auto-[0-9]{8}-[0-9]+')
      && request.resource.data.status=="open"
      && request.resource.data.autoCreated==true
      && request.resource.data.version==1
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.createdAt==request.time
      && request.resource.data.keys().hasOnly(["name","status","autoCreated","createdAt","createdBy","version"]));
    allow update,delete:if master();
  }
  match /countControl/{id}{
    allow read:if master()||actual();
    allow create,update:if master() || (actual()
      && request.resource.data.openSessionId is string
      && request.resource.data.openSessionId.size()>0
      && request.resource.data.version is number
      && request.resource.data.updatedAt==request.time
      && request.resource.data.updatedBy==request.auth.uid
      && existsAfter(/databases/$(database)/documents/countSessions/$(request.resource.data.openSessionId))
      && getAfter(/databases/$(database)/documents/countSessions/$(request.resource.data.openSessionId)).data.status=="open"
      && getAfter(/databases/$(database)/documents/countSessions/$(request.resource.data.openSessionId)).data.autoCreated==true
      && getAfter(/databases/$(database)/documents/countSessions/$(request.resource.data.openSessionId)).data.createdBy==request.auth.uid);
    allow delete:if false;
  }
  match /countEntries/{id}{
    allow read:if master()||actual();
    allow create:if (master()||actual())
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.createdAt==request.time
      && request.resource.data.qty is number && request.resource.data.qty>=0
      && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
      && get(/databases/$(database)/documents/countSessions/$(request.resource.data.sessionId)).data.status=="open";
    allow update:if (master()||actual())
      && resource.data.createdBy==request.auth.uid
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.itemId==resource.data.itemId
      && request.resource.data.sessionId==resource.data.sessionId
      && request.resource.data.createdAt==request.time
      && request.resource.data.qty is number && request.resource.data.qty>=0
      && get(/databases/$(database)/documents/countSessions/$(request.resource.data.sessionId)).data.status=="open";
    allow delete:if false;
  }
  match /actualHistory/{id}{
    allow read:if master();
    allow create:if (master()||actual())
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.createdAt==request.time
      && request.resource.data.newQty is number && request.resource.data.newQty>=0
      && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
      && request.resource.data.countEntryId is string
      && existsAfter(/databases/$(database)/documents/countEntries/$(request.resource.data.countEntryId))
      && linkedCountEntry().itemId==request.resource.data.itemId
      && linkedCountEntry().sessionId==request.resource.data.sessionId
      && linkedCountEntry().createdBy==request.auth.uid
      && linkedCountEntry().qty==request.resource.data.newQty;
    allow update,delete:if false;
  }
  match /tallyImports/{id}{
    allow read:if master()||tally();
    allow create:if (master()||tally()) && request.resource.data.createdBy==request.auth.uid;
    allow update:if active()
      && request.resource.data.createdBy==resource.data.createdBy
      && request.resource.data.fileHash==resource.data.fileHash
      && (
        (((master()||tally()) && resource.data.createdBy==request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","matched","created","rowCount","error","completedAt"]))
        || (master()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rolledBackAt","rolledBackBy","rollbackItems","rollbackSkipped"]))
      );
    allow delete:if false;
  }
  match /tallySnapshots/{id}{
    allow read:if master()||tally();
    allow create:if (master()||tally())
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.snapshotVersion==2
      && request.resource.data.importId is string
      && exists(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId))
      && get(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId)).data.createdBy==request.auth.uid
      && get(/databases/$(database)/documents/tallyImports/$(request.resource.data.importId)).data.status=="processing"
      && request.resource.data.itemId is string
      && request.resource.data.importedQty is number && request.resource.data.importedQty>=0
      && request.resource.data.hadPrevious is bool
      && ((request.resource.data.hadPrevious==true && request.resource.data.previousQty is number && request.resource.data.previousQty>=0)
          || (request.resource.data.hadPrevious==false && request.resource.data.previousQty==null));
    allow update,delete:if false;
  }
  match /unitConversionHistory/{id}{allow read,create:if master();allow update,delete:if false;}
  match /userAudit/{id}{allow read,create:if master();allow update,delete:if false;}
  match /recountRequests/{id}{
    allow read:if master()||actual();
    allow create:if master();
    allow update:if master() || (actual() && resource.data.status=="open" && request.resource.data.status=="completed"
      && request.resource.data.itemId==resource.data.itemId
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","completedAt","completedBy"])
      && request.resource.data.completedBy==request.auth.uid);
    allow delete:if false;
  }
  match /movements/{id}{
    allow read:if master()||tally();
    allow create:if (master()||tally())
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.createdAt==request.time
      && request.resource.data.qty is number && request.resource.data.qty>0
      && request.resource.data.type in ["IN","OUT"]
      && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId));
    allow update,delete:if false;
  }
  match /ocrMappings/{id}{
    allow read:if active();
    allow create:if (master()||tally())
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.updatedBy==request.auth.uid
      && request.resource.data.key is string && request.resource.data.key.size()>0
      && request.resource.data.sourceText is string
      && request.resource.data.itemId is string
      && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId));
    allow update:if (master()||tally())
      && request.resource.data.createdBy==resource.data.createdBy
      && request.resource.data.updatedBy==request.auth.uid
      && request.resource.data.key==resource.data.key
      && request.resource.data.itemId is string
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["itemId","sourceText","updatedAt","updatedBy"])
      && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId));
    allow delete:if master();
  }
  match /variances/{id}{allow read,write:if master();}
  match /approvals/{id}{allow read,create:if master();allow update,delete:if false;}
  match /auditCheckpoints/{id}{
    allow read:if master();
    allow create,update:if master()
      && request.resource.data.month==id
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.status in ["processing","complete"];
    allow delete:if false;
    match /items/{itemId}{
      allow read:if master();
      allow create,update:if master()
        && request.resource.data.itemId==itemId
        && request.resource.data.createdBy==request.auth.uid
        && request.resource.data.createdAt==request.time;
      allow delete:if false;
    }
  }
  match /{document=**}{allow read,write:if false;}
 }
}
